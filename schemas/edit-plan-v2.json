              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            }
          ],
          "title": "Overlap"
        },
        "repetition": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            }
          ],
          "title": "Repetition"
        },
        "shake_obstruction": {
          "anyOf": [
            {
              "minimum": 0.0,
