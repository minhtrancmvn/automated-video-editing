    "Provenance": {
      "additionalProperties": false,
      "description": "Data-only provenance metadata; command execution fields are forbidden.",
      "properties": {
        "planner": {
          "minLength": 1,
          "title": "Planner",
          "type": "string"
        }
      },
      "required": [
        "planner"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ScoreBreakdown": {
      "additionalProperties": false,
      "description": "Typed positive and penalty score dimensions.",
      "properties": {
        "penalties": {
          "$ref": "#/$defs/PenaltyScores"
        },
        "positive": {
          "$ref": "#/$defs/PositiveScores"
        }
      },
      "required": [
        "positive",
        "penalties"
      ],
      "title": "ScoreBreakdown",
      "type": "object"
    },
    "TimelineClipV2": {
      "additionalProperties": false,
      "description": "Version 2 source interval with score, evidence, and identity metadata.",
      "properties": {
        "analysis_reference": {
          "minLength": 1,
          "title": "Analysis Reference",
          "type": "string"
        },
        "analysis_version": {
          "minLength": 1,
          "title": "Analysis Version",
          "type": "string"
        },
        "chapter_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chapter Id"
        },
        "clip_id": {
          "minLength": 1,
          "title": "Clip Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?:\\+?(?:0+(?:\\.\\d+)?|\\.\\d+|1(?:\\.0*)?))$",
              "type": "string"
            }
          ],
          "title": "Confidence"
        },
        "dedup_group": {
          "minLength": 1,
          "title": "Dedup Group",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "framing": {
          "$ref": "#/$defs/FramingV2"
        },
        "overall_score": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            }
          ],
          "title": "Overall Score"
        },
        "planner_version": {
          "minLength": 1,
          "title": "Planner Version",
          "type": "string"
        },
        "score_breakdown": {
          "$ref": "#/$defs/ScoreBreakdown"
        },
        "selection_reason": {
          "minLength": 1,
          "title": "Selection Reason",
          "type": "string"
        },
        "source_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^\\+?(?=[0-9.]*[1-9])(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            }
          ],
          "title": "Source End"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_identity": {
          "minLength": 1,
          "title": "Source Identity",
          "type": "string"
        },
        "source_proxy_mapping_reference": {
          "minLength": 1,
          "title": "Source Proxy Mapping Reference",
          "type": "string"
        },
        "source_start": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            }
          ],
