    },
    "TransitionV2": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cut"
              }
            }
          },
          "then": {
            "properties": {
              "duration": {
                "anyOf": [
                  {
                    "maximum": 0,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "pattern": "^\\+?0+(?:\\.0*)?$",
                    "type": "string"
                  }
                ]
              },
              "relation": {
                "enum": [
                  "continuous_action",
                  "matched_motion",
                  "same_event"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dissolve"
              }
            }
          },
          "then": {
            "properties": {
              "duration": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  {
                    "pattern": "^\\+?(?=[0-9.]*[1-9])(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
                    "type": "string"
                  }
                ]
              },
              "relation": {
                "enum": [
                  "same_event",
                  "same_place_time_shift"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fade"
              }
            }
          },
          "then": {
            "properties": {
              "duration": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  {
                    "pattern": "^\\+?(?=[0-9.]*[1-9])(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
                    "type": "string"
                  }
                ]
              },
              "relation": {
                "enum": [
                  "chapter_boundary",
                  "story_open_close"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fade_black"
              }
            }
          },
          "then": {
            "properties": {
              "duration": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  {
                    "pattern": "^\\+?(?=[0-9.]*[1-9])(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
                    "type": "string"
                  }
                ]
              },
              "relation": {
                "enum": [
                  "chapter_boundary",
                  "location_change",
                  "time_jump"
                ]
              }
            }
          }
        }
      ],
      "description": "Semantic transition between adjacent version 2 clips.",
      "properties": {
        "audio_policy": {
          "enum": [
            "cut",
            "crossfade",
            "fade_out_in"
          ],
          "title": "Audio Policy",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?:\\+?(?:0+(?:\\.\\d+)?|\\.\\d+|1(?:\\.0*)?))$",
