            },
            {
              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            }
          ],
          "title": "Shake Obstruction"
        },
        "weak_boundary": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            }
          ],
          "title": "Weak Boundary"
        }
      },
      "required": [
        "blur_exposure",
        "shake_obstruction",
        "incomplete",
        "weak_boundary",
        "repetition",
        "overlap"
      ],
      "title": "PenaltyScores",
      "type": "object"
    },
    "PlanSourceV2": {
      "additionalProperties": false,
      "description": "Version 2 source with strict scalar fields and JSON path support.",
      "properties": {
        "duration": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^\\+?(?=[0-9.]*[1-9])(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            }
          ],
          "title": "Duration"
        },
        "has_audio": {
          "default": true,
          "title": "Has Audio",
          "type": "boolean"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "identity": {
          "minLength": 1,
          "title": "Identity",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "identity",
        "duration"
      ],
      "title": "PlanSourceV2",
      "type": "object"
    },
