        "source_start",
        "source_end",
        "timeline_start",
        "speed",
        "framing",
        "selection_reason",
        "overall_score",
        "score_breakdown",
        "analysis_reference",
        "source_proxy_mapping_reference",
        "dedup_group",
        "vertical_suitability",
        "confidence",
        "planner_version",
        "analysis_version"
