{
  "$defs": {
    "CropKeyframe": {
      "additionalProperties": false,
      "description": "One exact clip-local crop-center sample.",
      "properties": {
        "center_x": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?:\\+?(?:0+(?:\\.\\d+)?|\\.\\d+|1(?:\\.0*)?))$",
              "type": "string"
            }
          ],
          "title": "Center X"
        },
        "center_y": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?:\\+?(?:0+(?:\\.\\d+)?|\\.\\d+|1(?:\\.0*)?))$",
              "type": "string"
            }
          ],
          "title": "Center Y"
        },
        "fallback": {
          "enum": [
            "tracked",
            "hold",
            "ease_center",
            "static"
          ],
          "title": "Fallback",
          "type": "string"
        },
        "subject_box_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Box Id"
        },
        "time": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^\\+?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            }
          ],
          "title": "Time"
        }
      },
      "required": [
        "time",
        "center_x",
        "center_y",
        "fallback"
      ],
      "title": "CropKeyframe",
      "type": "object"
    },
    "FramingV2": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "center_crop"
              }
            }
          },
          "then": {
            "properties": {
              "background": {
                "type": "null"
              },
              "keyframes": {
                "maxItems": 0
              },
              "track_clip_id": {
                "type": "null"
              },
              "track_id": {
                "type": "null"
              },
              "track_source_identity": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "fit_background"
              }
            }
          },
          "then": {
            "properties": {
              "background": {
                "type": "string"
              },
              "keyframes": {
                "maxItems": 0
              },
              "track_clip_id": {
                "type": "null"
              },
              "track_id": {
                "type": "null"
              },
              "track_source_identity": {
                "type": "null"
              }
            },
            "required": [
              "background"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "tracked_crop"
              }
            }
          },
          "then": {
            "properties": {
              "background": {
                "type": "null"
              },
              "keyframes": {
                "minItems": 1
              },
              "track_clip_id": {
                "minLength": 1,
                "type": "string"
              },
              "track_id": {
                "minLength": 1,
                "type": "string"
              },
              "track_source_identity": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "track_id",
              "track_clip_id",
              "track_source_identity"
            ]
          }
        }
      ],
      "description": "Version 2 output framing, including identity-bound tracked crops.",
      "properties": {
        "background": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Background"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/CropKeyframe"
          },
          "title": "Keyframes",
          "type": "array"
        },
        "mode": {
          "enum": [
            "center_crop",
            "fit_background",
            "tracked_crop"
          ],
          "title": "Mode",
          "type": "string"
        },
        "track_clip_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Clip Id"
        },
        "track_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "track_source_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Source Identity"
        }
      },
      "required": [
        "mode"
      ],
      "title": "FramingV2",
      "type": "object"
    },
    "OutputSpecV2": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "short"
              }
            }
          },
          "then": {
            "properties": {
              "filename": {
                "pattern": "^short-(?:0[1-9]|[1-9][0-9])\\.mp4$"
              },
              "height": {
                "const": 1920
              },
              "width": {
                "const": 1080
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "long"
              }
            }
          },
          "then": {
            "properties": {
              "filename": {
                "const": "long.mp4"
              },
              "height": {
                "const": 1080
              },
              "width": {
                "const": 1920
              }
            }
          }
        }
      ],
      "description": "Collision-proof version 2 output identity and media properties.",
      "properties": {
        "audio": {
          "default": "source",
          "enum": [
            "source",
            "silence",
            "none"
          ],
          "title": "Audio",
          "type": "string"
        },
        "codec": {
          "const": "libx264",
          "title": "Codec",
          "type": "string"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "frame_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^\\+?(?=[0-9.]*[1-9])(?:\\d+(?:\\.\\d*)?|\\.\\d+)$",
              "type": "string"
            }
          ],
          "title": "Frame Rate"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "short",
            "long"
          ],
          "title": "Kind",
          "type": "string"
        },
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "theme_summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theme Summary"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "plan_id",
        "filename",
        "kind",
        "width",
        "height",
        "frame_rate",
        "codec"
      ],
      "title": "OutputSpecV2",
      "type": "object"
    },
    "PenaltyScores": {
      "additionalProperties": false,
      "description": "Highlight penalties retained separately from positive scores.",
      "properties": {
        "blur_exposure": {
          "anyOf": [
