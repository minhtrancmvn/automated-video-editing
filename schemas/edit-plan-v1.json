{
  "$defs": {
    "Framing": {
      "additionalProperties": false,
      "description": "Output framing primitive supported by Phase 1.",
      "properties": {
        "mode": {
          "enum": [
            "center_crop",
            "fit_background"
          ],
          "title": "Mode",
          "type": "string"
        },
        "background": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Background"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Framing",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "description": "Requested output properties.",
      "properties": {
        "kind": {
          "enum": [
            "short",
            "long"
          ],
          "title": "Kind",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "frame_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)\\+?(?=.*[1-9])\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Frame Rate"
        },
        "codec": {
          "const": "libx264",
          "title": "Codec",
          "type": "string"
        },
        "audio": {
          "default": "source",
          "enum": [
            "source",
            "silence",
            "none"
          ],
          "title": "Audio",
          "type": "string"
        },
        "color": {
          "default": "passthrough",
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "width",
        "height",
        "frame_rate",
        "codec"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "PlanSource": {
      "additionalProperties": false,
      "description": "Source identity and media facts referenced by an edit plan.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "identity": {
          "minLength": 1,
          "title": "Identity",
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)\\+?(?=.*[1-9])\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Duration"
        },
        "has_audio": {
          "default": true,
          "title": "Has Audio",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "path",
        "identity",
        "duration"
      ],
      "title": "PlanSource",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Data-only provenance metadata; command execution fields are forbidden.",
      "properties": {
        "planner": {
          "minLength": 1,
          "title": "Planner",
          "type": "string"
        }
      },
      "required": [
        "planner"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "TimelineClip": {
      "additionalProperties": false,
      "description": "One source interval placed consecutively on timeline.",
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_start": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)\\+?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Source Start"
        },
        "source_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)\\+?(?=.*[1-9])\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Source End"
        },
        "timeline_start": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)\\+?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Timeline Start"
        },
        "speed": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)\\+?(?=.*[1-9])\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Speed"
        },
        "framing": {
          "$ref": "#/$defs/Framing"
        },
        "selection_reason": {
          "minLength": 1,
          "title": "Selection Reason",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?:\\+?(?:0+(?:\\.\\d+)?|\\.\\d+|1(?:\\.0*)?))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "source_id",
        "source_start",
        "source_end",
        "timeline_start",
        "speed",
        "framing",
        "selection_reason"
      ],
      "title": "TimelineClip",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "description": "Transition between adjacent clips.",
      "properties": {
        "from_clip": {
          "minimum": 0,
          "title": "From Clip",
          "type": "integer"
        },
        "to_clip": {
          "minimum": 0,
          "title": "To Clip",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "cut",
            "dissolve"
          ],
          "title": "Kind",
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)\\+?(?=.*[1-9])\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Duration"
        }
      },
      "required": [
        "from_clip",
        "to_clip",
        "kind",
        "duration"
      ],
      "title": "Transition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Version 1 edit plan containing data, never shell commands.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "planner_version": {
      "minLength": 1,
      "title": "Planner Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/PlanSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "clips": {
      "items": {
        "$ref": "#/$defs/TimelineClip"
      },
      "minItems": 1,
      "title": "Clips",
      "type": "array"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/Transition"
      },
      "title": "Transitions",
      "type": "array"
    },
    "output": {
      "$ref": "#/$defs/OutputSpec"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "schema_version",
    "planner_version",
    "sources",
    "clips",
    "output",
    "provenance"
  ],
  "title": "EditPlan",
  "type": "object"
}
